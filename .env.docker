# Docker Compose 环境变量配置
# 复制此文件为 .env，然后填入你的配置

# ===================
# Auth0 配置
# ===================
AUTH0_DOMAIN=your-domain.au.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_API_AUDIENCE=https://qing-agent-api

# ===================
# 前端配置
# ===================
VITE_API_BASE_URL=http://localhost:8000
